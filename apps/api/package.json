{
  "name": "@foundation-like-notion/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "auth:hash": "tsx src/hash-password.ts",
    "build": "tsc -p tsconfig.json",
    "config:resolve": "tsx src/resolve-property-names.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.4",
    "@foundation-like-notion/contracts": "*",
    "@notionhq/client": "^5.12.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.20.5"
  }
}
